<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme -->
    
    <!-- Backgrounds & Borders -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F2F2F7" />
    
    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="Black" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#3A3A3C" />
    
    <!-- Secondary & Status -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#0AE66D" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
    
    <!-- Item Highlights (Selected & Hover) - 100% Solid Colors -->
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="SecondarySelectedBrush" Color="#D1D1D6" />
    <SolidColorBrush x:Key="SecondarySelectedHoverBrush" Color="#C7C7CC" />
    <SolidColorBrush x:Key="SecondarySelectedBorderBrush" Color="#0AE66D" />
</ResourceDictionary>
