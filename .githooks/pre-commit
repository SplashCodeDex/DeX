#!/bin/sh
# Pre-commit gate: desktop Compose tests must pass before commit.
# Enabled via: git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
./gradlew.bat :composeApp:desktopTest --console=plain
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "[pre-commit] Desktop tests failed. Commit blocked."
fi
exit $RESULT
