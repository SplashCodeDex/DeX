<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout (inflated by the system notification framework, not appcompat),
     so the platform android:drawableStart attribute is correct here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="UseCompatTextViewDrawableXml">

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pairing_request"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notification_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/notif_pairing_tap"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" />

    <TextView
        android:id="@+id/notification_device_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_stat_dex"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="@string/device_unknown"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

</LinearLayout>
