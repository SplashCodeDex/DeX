<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Every DeX PC's certificate is signed by the bundled DeX root CA, so Cronet
         (HTTP/3/QUIC) trusts every PC automatically — no user setup needed. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="@raw/dex_ca"/>
        </trust-anchors>
    </base-config>
</network-security-config>
