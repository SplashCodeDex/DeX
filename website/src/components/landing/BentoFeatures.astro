---
const tiles = [
  {
    speed: 'slow',
    className:
      'group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-8 shadow-2xl backdrop-blur-xl transition-colors hover:bg-white/10 dark:border-white/5 dark:bg-black/20 dark:hover:bg-black/40 md:col-span-2 md:row-span-2',
    icon: '<rect width="5" height="5" x="3" y="3" rx="1"></rect><rect width="5" height="5" x="16" y="3" rx="1"></rect><rect width="5" height="5" x="3" y="16" rx="1"></rect><path d="M21 16h-3a2 2 0 0 0-2 2v3"></path><path d="M21 21h.01"></path><path d="M12 7v3a2 2 0 0 1-2 2H7"></path><path d="M3 12h.01"></path><path d="M12 3h.01"></path><path d="M12 16v.01"></path><path d="M9 21h6"></path><path d="M8 21v-3a2 2 0 0 0-2-2H3"></path>',
    iconClass: 'mb-4 h-12 w-12 text-primary-500 drop-shadow-md transition-transform duration-500 group-hover:scale-110 group-hover:translate-x-1',
    glow: '<div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-primary-500/30 blur-3xl transition-all group-hover:bg-primary-500/50"></div>',
    title: 'Pair in seconds',
    titleClass: 'mb-2 text-2xl font-bold text-foreground',
    body: 'Scan a code with your phone camera or type a short PIN. Your devices remember each other after that — no accounts, no signing in. Think AirDrop, but for Android and PC.',
    bodyClass: 'text-muted-foreground text-lg leading-relaxed',
  },
  {
    speed: 'fast',
    className:
      'group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur-xl transition-colors hover:bg-white/10 dark:border-white/5 dark:bg-black/20 dark:hover:bg-black/40 lg:col-span-1 lg:row-span-1',
    icon: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path>',
    iconClass: 'h-8 w-8 text-blue-400 drop-shadow-md transition-transform duration-700 group-hover:rotate-180',
    glow: '',
    title: 'Clipboard sync',
    titleClass: 'mb-1 text-lg font-bold text-foreground',
    body: 'Copy on your phone, paste on your desktop.',
    bodyClass: 'text-sm text-muted-foreground',
  },
  {
    speed: 'medium',
    className:
      'group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur-xl transition-colors hover:bg-white/10 dark:border-white/5 dark:bg-black/20 dark:hover:bg-black/40 lg:col-span-1 lg:row-span-1',
    icon: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>',
    iconClass: 'h-8 w-8 text-green-400 drop-shadow-md transition-transform duration-500 group-hover:-translate-y-1 group-hover:scale-110',
    glow: '',
    title: 'Full Wi-Fi speed',
    titleClass: 'mb-1 text-lg font-bold text-foreground',
    body: 'Videos, whole camera rolls, giant folders — they move as fast as your Wi-Fi can carry them.',
    bodyClass: 'text-sm text-muted-foreground',
  },
  {
    speed: 'fast',
    className:
      'group relative flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur-xl transition-colors hover:bg-white/10 dark:border-white/5 dark:bg-black/20 dark:hover:bg-black/40 md:col-span-2 lg:row-span-1',
    wide: true,
    icon: '<circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path>',
    iconClass: 'h-8 w-8 text-purple-400 drop-shadow-md transition-transform duration-500 group-hover:scale-125 group-hover:rotate-12',
    glow: '',
    title: 'Works anywhere',
    titleClass: 'mb-1 text-xl font-bold text-foreground',
    body: 'Sending from home to the office? Phone and computer on different networks? Files still go straight across, device to device.',
    bodyClass: 'text-muted-foreground',
  },
  {
    speed: 'medium',
    className:
      'group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur-xl transition-colors hover:bg-white/10 dark:border-white/5 dark:bg-black/20 dark:hover:bg-black/40 lg:col-span-1 lg:row-span-1',
    icon: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>',
    iconClass: 'h-8 w-8 text-orange-400 drop-shadow-md transition-transform duration-500 group-hover:scale-110 group-hover:translate-x-1',
    glow: '',
    title: 'Grab the right file',
    titleClass: 'mb-1 text-lg font-bold text-foreground',
    body: 'Browse folders on either device and pick exactly the file you meant to send.',
    bodyClass: 'text-sm text-muted-foreground',
  },
  {
    speed: 'slow',
    className:
      'group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur-xl transition-colors hover:bg-white/10 dark:border-white/5 dark:bg-black/20 dark:hover:bg-black/40 lg:col-span-1 lg:row-span-1',
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path>',
    iconClass: 'h-8 w-8 text-emerald-400 drop-shadow-md transition-transform duration-500 group-hover:scale-110',
    glow: '',
    title: 'Private by design',
    titleClass: 'mb-1 text-lg font-bold text-foreground',
    body: 'Files travel directly between your devices and never touch our servers — because there are none.',
    bodyClass: 'text-sm text-muted-foreground',
  },
];
---

<section id="features" class="relative scroll-mt-24 overflow-hidden px-4 py-24 md:py-32">
  <div class="absolute -z-10 right-1/4 top-0 h-80 w-80 rounded-full bg-primary-500/20 blur-[120px]"></div>
  <div class="absolute -z-10 bottom-0 left-1/4 h-[400px] w-[400px] rounded-full bg-purple-500/15 blur-[150px]"></div>

  <div class="mx-auto max-w-6xl">
    <div class="landing-reveal mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl">
        Everything the cable used to do
      </h2>
      <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
        DeX sends files straight between your Android phone and your Windows or macOS computer
        over Wi-Fi. Nothing sits in the middle.
      </p>
    </div>

    <div class="grid auto-rows-[250px] grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {tiles.map((tile) => (
        <div data-parallax={tile.speed} class={tile.className}>
          {tile.glow && <Fragment set:html={tile.glow} />}
          {tile.wide && (
            <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          )}
          {tile.wide ? (
            <div class="flex h-full items-center gap-6">
              <div class="flex-shrink-0 rounded-2xl bg-purple-500/20 p-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={tile.iconClass}>
                  <Fragment set:html={tile.icon} />
                </svg>
              </div>
              <div class="z-10 text-left">
                <h3 class={tile.titleClass}>{tile.title}</h3>
                <p class={tile.bodyClass}>{tile.body}</p>
              </div>
            </div>
          ) : (
            <>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={tile.iconClass}
              >
                <Fragment set:html={tile.icon} />
              </svg>
              <div class="mt-auto z-10">
                <h3 class={tile.titleClass}>{tile.title}</h3>
                <p class={tile.bodyClass}>{tile.body}</p>
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
