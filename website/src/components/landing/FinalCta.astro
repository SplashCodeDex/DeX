---
import BrandMark from './BrandMark.astro';
---

<section class="relative px-4 pb-28 pt-8 md:pb-36">
  <div
    class="landing-reveal glass-card mx-auto max-w-4xl rounded-3xl p-10 text-center shadow-lg sm:p-14"
  >
    <h2 class="text-balance text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      Ready when your phone is
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground">
      Grab <BrandMark /> free for Windows, macOS, or Android. Sending takes
      one scan.
    </p>
    <a
      href="https://github.com/SplashCodeDex/DeX/releases"
      class="group relative mt-9 inline-flex h-12 items-center justify-center gap-2 overflow-hidden whitespace-nowrap rounded-full px-8 text-base font-medium text-white shadow-lg shadow-primary-500/20 transition-all duration-200 hover:shadow-primary-500/25 focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none active:scale-[0.98] [&_svg]:size-4 [&_svg]:shrink-0 hover:shadow-md bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-700 hover:to-primary-600 dark:from-primary-500 dark:to-primary-400 dark:hover:from-primary-600 dark:hover:to-primary-500 cursor-pointer"
    >
      <span class="pointer-events-none absolute inset-0 bg-white/20 opacity-0 transition-opacity duration-200 group-hover:opacity-100"></span>
      Download <BrandMark /> — it&rsquo;s free
    </a>
    <p class="mt-5 text-sm text-muted-foreground">
      No account. No card. Your files never touch a server.
    </p>
  </div>
</section>

