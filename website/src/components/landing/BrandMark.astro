---
/**
 * Inline DeX wordmark for use inside sentences, headings, and buttons.
 * Rendered as live text in the brand logo face ('Creepy Notes', bold), so it
 * reads like any other word: it inherits size and color from the surrounding
 * typography instead of needing the old image canvas scaling.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['font-logo font-bold', className]}>DeX</span>
