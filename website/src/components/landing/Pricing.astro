---
import { site } from '../../data/site';
import BrandMark from './BrandMark.astro';
const { free, pro } = site.pricing;

const check = '<path d="M20 6 9 17l-5-5"></path>';
---

<section id="pricing" class="relative scroll-mt-24 overflow-hidden py-24 md:py-28">
  <div class="absolute -z-10 left-1/3 top-0 h-80 w-80 rounded-full bg-primary-500/15 blur-[120px]"></div>

  <div class="mx-auto max-w-6xl px-4">
    <div class="landing-reveal mx-auto mb-16 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl">
        Free where it matters
      </h2>
      <p class="text-lg text-muted-foreground">
        Sending between devices on the same Wi-Fi costs nothing, forever. Pro adds sending
        across the internet — for when home isn&rsquo;t where your computer is.
      </p>
    </div>

    <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
      <div class="landing-reveal rounded-3xl border border-white/10 bg-white/5 p-8 shadow-2xl backdrop-blur-xl dark:border-white/5 dark:bg-black/20">
        <h3 class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">Free</h3>
        <p class="mt-4 flex items-baseline gap-2">
          <span class="text-5xl font-black tracking-tight text-foreground">{free.price}</span>
          <span class="text-sm text-muted-foreground">{free.period}</span>
        </p>
        <a
          href={site.downloadPage}
          class="group relative mt-8 inline-flex h-11 w-full items-center justify-center gap-2 overflow-hidden whitespace-nowrap rounded-lg text-sm font-medium text-white shadow-lg shadow-primary-500/20 transition-all duration-200 hover:shadow-primary-500/30 focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none active:scale-[0.98] [&_svg]:size-4 [&_svg]:shrink-0 hover:shadow-md bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-700 hover:to-primary-600 dark:from-primary-500 dark:to-primary-400 dark:hover:from-primary-600 dark:hover:to-primary-500 cursor-pointer"
        >
          <span class="pointer-events-none absolute inset-0 bg-white/20 opacity-0 transition-opacity duration-200 group-hover:opacity-100"></span>
          Download <BrandMark class="h-[1.1em]" fixedLight />
        </a>
        <ul class="mt-8 space-y-3">
          {free.features.map((feature) => (
            <li class="flex items-start gap-3 text-sm text-foreground/80">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 size-4 shrink-0 text-primary-500">
                <Fragment set:html={check} />
              </svg>
              {feature}
            </li>
          ))}
        </ul>
      </div>

      <div class="landing-reveal relative rounded-3xl border border-primary-500/40 bg-white/5 p-8 shadow-2xl backdrop-blur-xl dark:bg-black/20" style="transition-delay: 0.15s">
        <span class="absolute -top-3 right-6 rounded-full bg-primary-600 px-3 py-1 text-xs font-bold text-white shadow-lg dark:bg-primary-500">{pro.badge}</span>
        <h3 class="text-sm font-semibold tracking-wide text-primary-500 uppercase">
          <BrandMark class="h-[1.3em]" /> {pro.name}
        </h3>
        <p class="mt-4 flex items-baseline gap-2">
          <span class="text-5xl font-black tracking-tight text-foreground">{pro.price}</span>
          <span class="text-sm text-muted-foreground">{pro.period}</span>
        </p>
        <span
          class="mt-8 inline-flex h-11 w-full cursor-default items-center justify-center gap-2 rounded-lg border border-input bg-background/50 text-sm font-medium text-foreground backdrop-blur-md transition-colors hover:bg-muted"
        >
          {pro.cta} — at launch
        </span>
        <ul class="mt-8 space-y-3">
          {pro.features.map((feature) => (
            <li class="flex items-start gap-3 text-sm text-foreground/80">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 size-4 shrink-0 text-primary-500">
                <Fragment set:html={check} />
              </svg>
              {feature}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="landing-reveal mt-10 text-center text-sm text-muted-foreground">
      Every file you receive lands in your Downloads folder — never on someone else&rsquo;s server.
    </p>
  </div>
</section>
