---
import { site } from '../data/site';
const steps = [
  {
    title: 'Install both sides',
    body: `Get DeX for Windows or macOS, then add the ${site.name} companion app on your Android phone.`,
  },
  {
    title: 'Pair once',
    body: 'Scan the QR or enter the PIN. A verified pairing mints a per-device token, so every later connection is automatic.',
  },
  {
    title: 'Send anything',
    body: `Drop files onto the dock card. They land in ${site.receivedFolder} on the receiving machine.`,
  },
];
---

<section id="how-it-works" class="scroll-mt-28 py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">Three steps, no cables</h2>
      <p class="mt-4 text-mist/60">From install to first transfer in under two minutes.</p>
    </div>
    <ol class="mt-12 grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <li class="relative rounded-2xl glass p-6">
          <span class="font-mono text-sm font-bold text-accent">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist/60">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
