---
import { site } from '../data/site';
const faqs = [
  {
    q: 'Does DeX need the internet?',
    a: 'No. On a shared Wi-Fi network everything runs locally between your devices. The internet only matters when your phone and PC are on different networks and you use the remote transfer paths.',
  },
  {
    q: 'Is it compatible with LocalSend?',
    a: 'Yes. DeX speaks the LocalSend v2 protocol, so it can exchange files with other LocalSend-compatible apps on the same network.',
  },
  {
    q: 'Where do received files go?',
    a: `Received transfers are saved to ${site.receivedFolder} by default, with no cloud copy in between.`,
  },
  {
    q: 'How is pairing kept secure?',
    a: 'Pairing requires proof: the phone must echo the PIN displayed on screen within a 60-second window. A verified pairing mints a per-device bearer token, identity material is never broadcast during discovery, and trust checks run in constant time.',
  },
  {
    q: 'Which platforms are supported?',
    a: 'DeX desktop runs on Windows 10+ and macOS from one shared Kotlin Multiplatform codebase. The companion app is Android.',
  },
  {
    q: 'What does Pro add?',
    a: `Pro unlocks ${site.pricing.pro.features.slice(1, -2).join(', ').toLowerCase()}, plus lifetime updates and priority support. The free core stays fully usable for LAN transfers.`,
  },
];
---

<section id="faq" class="scroll-mt-28 py-24">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-center text-balance text-3xl font-bold tracking-tight sm:text-4xl">Questions, answered</h2>
    <div class="mt-12 space-y-3">
      {faqs.map((faq) => (
        <details class="group rounded-2xl glass px-6 py-4 open:bg-mist/8">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold marker:hidden">
            {faq.q}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-accent transition-transform group-open:rotate-45">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-mist/65">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
