# DeX Cloud Relay & Sync Host Configuration (Plan 032)
# Domain name pointing to this VPS via A / AAAA DNS records (e.g. relay.dexstudios.com)
DEX_DOMAIN=relay.dexstudios.com

# Port on which the internal Ktor Netty server listens (default 8443)
DEX_PORT=8443

# Google Sign-In OAuth 2.0 Web Client ID (matches Credential Manager serverClientId)
# REQUIRED in production. Sign-in bearer tokens are cryptographically verified.
DEX_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Local test / development flags only (NEVER set to 1 in production)
DEX_FIXTURE_AUTH=0
DEX_DEV=0
